{
  "name": "weselaja-typescript",
  "version": "1.0.0",
  "description": "Standalone TypeScript integration for the WeselAja payment provider",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "example": "npm run build && node dist/example.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
