services:
  weselaja-mcp:
    build:
      context: .
      dockerfile: Dockerfile

    image: weselaja-mcp:local
    container_name: weselaja-mcp
    restart: unless-stopped

    # Development only: allow writing to the Windows bind-mounted directory.
    user: "0:0"

    ports:
      - "127.0.0.1:3001:3001"

    env_file:
      - .env

    environment:
      MCP_TRANSPORT: "http"
      MCP_HTTP_URL: "http://0.0.0.0:3001"
      WESELAJA_GENERATOR_OUTPUT_DIR: "/app/generated"

    volumes:
      - type: bind
        source: "C:/Kerja/XenithPay/mcp/WeselAjaMcpServer/generated"
        target: /app/generated
        bind:
          create_host_path: true